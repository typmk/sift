;; What each host makes of a tag. typeflow.cljc reads this; the flow itself
;; is host-neutral and a dialect is a row here, not a namespace.
;;
;;   :primitives   tags the compiler keeps unboxed — a math op over only these
;;                 is unboxed, over anything else is boxed (JVM). JS has one
;;                 number and no boxing: the set is empty and boxed-math is
;;                 not a question.
;;   :literal      the tag a literal carries, by reader kind.
;;   :casts        core fns whose result is the named primitive.
;;   :core         return tags for core fns whose result the compiler knows.
;;                 :arith means "primitive iff every operand is primitive" —
;;                 Numbers.add(long,long) against Numbers.add(Object,Object).
;;   :math         the ops the JVM compiles through clojure.lang.Numbers and
;;                 warns on when boxed; compared as :arith.
;;   :interop      how a call names the host: instance call / field / static /
;;                 constructor, as a regex over the head symbol.
;;   :known-receiver  hints that make a receiver known to the host compiler
;;                 without a class: ^js on ClojureScript.
;;   :warns        which predictions this host's compiler actually emits, so a
;;                 prediction with no oracle is not reported as a fact.
{:jvm {:primitives #{"long" "double" "int" "float" "boolean" "char" "byte" "short"}
       ;; true/false are a BooleanExpr whose class is java.lang.Boolean — boxed,
       ;; so (.setFlag x true) matches setFlag(Boolean) and not setFlag(boolean)
       ;; only when both exist; numbers are primitive long/double
       :literal {:int "long" :float "double" :string "String" :char "char"
                 :bool "Boolean" :keyword "Keyword" :symbol "Symbol" :regex "Pattern"
                 :vector :vector :map :map :set :set :list :list :nil "nil"
                 ;; all-constant collections fold to the concrete class
                 :vector-const :vector-const :map-const :map-const :set-const :set-const}
       ;; what a concept or a walker tag is, as a class the dump has supers
       ;; for — IPersistentVector is not a java.util.List, PersistentVector is
       :concept-classes {:vector "IPersistentVector" :vector-const "PersistentVector"
                         :map "IPersistentMap" :map-const "PersistentArrayMap"
                         :set "IPersistentSet" :set-const "PersistentHashSet"
                         :list "PersistentList" :seq "ISeq"
                         "Number" "Number" "Fn" "AFunction" "js-literal" "Object"}
       :casts {"long" "long" "int" "int" "double" "double" "float" "float"
               "short" "short" "byte" "byte" "char" "char" "boolean" "boolean"}
       ;; What the JVM compiler knows a core call returns: :inline forms (count,
       ;; not, the predicates, the math) and vars carrying ^Tag (str, name,
       ;; subs, keyword, symbol, clojure.java.io). NOT vec, vector, list, assoc,
       ;; hash-map, first, nth, get, partial, comp: those are plain invokes and
       ;; return Object — (.messages b (list …)) reflected on clojure-mcp while
       ;; this table said :list. bin/oracle's :vars is the same fact, live.
       :core {"str" "String" "name" "String" "namespace" "String" "subs" "String"
              "count" "int" "alength" "int" "keyword" "Keyword" "symbol" "Symbol"
              "char-array" "char[]" "byte-array" "byte[]" "int-array" "int[]" "long-array" "long[]"
              "double-array" "double[]" "boolean-array" "boolean[]" "object-array" "Object[]"
              "fn" "AFunction" "fn*" "AFunction"
              ;; clojure.java.io carries return hints the compiler reads; keyed
              ;; by name because `head*` is the unqualified name (io/file -> file)
              "file" "java.io.File" "reader" "java.io.Reader" "writer" "java.io.Writer"
              "input-stream" "java.io.InputStream" "output-stream" "java.io.OutputStream"
              "as-file" "java.io.File" "as-url" "java.net.URL"
              "atom" "Atom" "class" "Class"
              "boolean" "boolean" "not" "boolean" "nil?" "boolean" "some?" "boolean"
              "empty?" "boolean" "seq?" "boolean" "map?" "boolean" "vector?" "boolean"
              "string?" "boolean" "number?" "boolean" "keyword?" "boolean"
              "+" :arith "-" :arith "*" :arith "/" :arith "inc" :arith "dec" :arith
              ;; mod is a plain defn with no :inline — it never reaches Numbers
              ;; and never warns (lume abn.clj:15, measured); quot and rem do
              "quot" :arith "rem" :arith "mod" nil "max" :arith "min" :arith "abs" :arith
              "<" "boolean" ">" "boolean" "<=" "boolean" ">=" "boolean" "==" "boolean"
              "zero?" "boolean" "pos?" "boolean" "neg?" "boolean" "even?" "boolean" "odd?" "boolean"
              ;; bit ops: Numbers.and(Object,Object) WARNS when an operand is
              ;; boxed (security.cljc:67, measured) but every overload RETURNS
              ;; long — so they are in :math and their tag is "long".
              "bit-and" "long" "bit-or" "long" "bit-xor" "long" "bit-not" "long"
              "bit-shift-left" "long" "bit-shift-right" "long" "unsigned-bit-shift-right" "long"}
       ;; Numbers is reached only through :inline, and :inline-arities says
       ;; when: comparisons, max and min at exactly two arguments, the
       ;; operators at two or more. (<= 200 status 299) is a plain call to
       ;; clojure.core/<= and the compiler says nothing about it — measured
       ;; on lume, email.clj:167, a "false positive" that was a wrong model.
       ;; Absent means any arity.
       ;; max and min are nary-inline like + — (max r g b) warns three times on
       ;; kora.core, and this table said only two arguments did
       :inline-arities {"mod" #{} "<" #{2} ">" #{2} "<=" #{2} ">=" #{2} "==" #{2}
                        "max" :two-or-more "min" :two-or-more
                        "+" :two-or-more "*" :two-or-more "/" :two-or-more "-" :one-or-more}
       ;; host members whose result the compiler knows to be primitive, so
       ;; math over them is unboxed: (quot (System/currentTimeMillis) 1000)
       ;; was a false positive on lume until this existed. Short list, on
       ;; purpose — what a corpus showed, not the JDK.
       :host-returns {"System/currentTimeMillis" "long" "System/nanoTime" "long"
                      "Math/abs" "double" "Math/floor" "double" "Math/ceil" "double" "Math/round" "long"
                      "Math/max" "double" "Math/min" "double" "Math/pow" "double" "Math/sqrt" "double"
                      "Integer/parseInt" "int" "Long/parseLong" "long" "Double/parseDouble" "double"
                      ".indexOf" "int" ".lastIndexOf" "int" ".length" "int" ".size" "int"
                      ".count" "int" ".compareTo" "int" ".hashCode" "int" ".intValue" "int"
                      ".longValue" "long" ".doubleValue" "double" ".isEmpty" "boolean"
                      ".equals" "boolean" ".contains" "boolean" ".startsWith" "boolean"
                      ".endsWith" "boolean" ".exists" "boolean" ".isDirectory" "boolean"
                      ".isFile" "boolean" ".toString" "String" ".getName" "String"
                      ".getMessage" "String" ".getPath" "String" ".trim" "String"}
       ;; constructors and statics with OVERLOADS on an argument position, so
       ;; an untyped argument is a reflective call. Everything else resolves
       ;; by name and arity alone; predicting on every static with an Object
       ;; argument measured 73 false positives on lume (Pattern/quote,
       ;; UUID/fromString, System/getenv). A JVM oracle could grow this from
       ;; assay's :refused lists; the list is what corpora showed.
       :overloaded #{"Date." "String." "StringBuilder." "OutputStreamWriter." "InputStreamReader."
                     "File." "URI." "URL." "BigDecimal." "BigInteger." "Thread." "Integer." "Long." "Double."
                     "java.util.Date." "java.io.File." "java.net.URI."
                     "URLDecoder/decode" "URLEncoder/encode" "java.net.URLDecoder/decode" "java.net.URLEncoder/encode"
                     ;; NOT Integer/parseInt or Long/parseLong: their overloads differ
                     ;; by ARITY, and arity resolves without types — lume, measured
                     "String/valueOf" "Integer/valueOf" "Long/valueOf" "Double/valueOf"
                     "Math/abs" "Math/max" "Math/min" "Math/round"
                     "String/format" "Arrays/asList" "Collections/sort"}
       ;; occurrence typing (Tobin-Hochstadt & Felleisen 2010): a predicate in
       ;; test position narrows its argument in the then-branch. Classes, not
       ;; primitives — (number? x) does not unbox x, so boxed-math is unmoved;
       ;; reflection on (.length s) after (string? s) is not.
       ;; RETRACTED 2026-08-27: the compiler never narrows a local on a predicate
       ;; (kora.core tokens.cljc, measured). Kept as the record; typeflow ignores it.
       :narrows {"string?" "String" "keyword?" "Keyword" "symbol?" "Symbol"
                 "map?" :map "vector?" :vector "set?" :set "seq?" :seq "coll?" :collection
                 "fn?" "Fn" "ifn?" "IFn" "char?" "Character" "boolean?" "Boolean"
                 "number?" "Number" "integer?" "Long" "int?" "Long" "double?" "Double"
                 "inst?" "java.util.Date" "uuid?" "java.util.UUID" "uri?" "java.net.URI"
                 "bytes?" "bytes"}
       :math #{"+" "-" "*" "/" "inc" "dec" "quot" "rem" "mod" "max" "min"
               "<" ">" "<=" ">=" "==" "zero?" "pos?" "neg?"
               "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right" "unsigned-bit-shift-right"
               "unchecked-add" "unchecked-subtract" "unchecked-multiply" "unchecked-inc" "unchecked-dec"}
       ;; a static call may be fully qualified — java.security.MessageDigest/getInstance
       ;; :ctor needs a name before the dot: `..` is not a constructor, and was
       ;; tagged "." — a known class — until clojure-mcp's (.. pb (start))
       :interop {:instance-call "^\\.[^-]" :field "^\\.-" :static "^([a-z][a-z0-9_]*\\.)*[A-Z][A-Za-z0-9_$.]*/" :ctor "[A-Za-z0-9_$]\\.$"}
       :known-receiver #{}
       :warns #{:boxed-math :reflection}}

 :js  {:primitives #{}
       :literal {:int "number" :float "number" :string "string" :char "string"
                 :bool "boolean" :keyword "Keyword" :symbol "Symbol" :regex "RegExp"
                 :vector :vector :map :map :set :set :list :list :nil "nil"}
       :casts {"int" "number" "long" "number" "double" "number" "boolean" "boolean"}
       :core {"str" "string" "name" "string" "count" "number" "+" "number" "-" "number"
              "*" "number" "inc" "number" "dec" "number" "not" "boolean" "nil?" "boolean"
              "vec" :vector "vector" :vector "hash-map" :map "assoc" :map "atom" "Atom"}
       :math #{}
       :interop {:instance-call "^\\.[^-]" :field "^\\.-" :static "^js/" :ctor "\\.$"}
       :known-receiver #{"js"}
       ;; NOTHING, measured. Modelled as "member access on a receiver without
       ;; ^js or a js/ global", :uninferred predicted 648 sites in defnet src
       ;; against a Closure log with 0 :infer-warning — Closure warns only for
       ;; an extern it cannot infer under :infer-externs, not for every
       ;; unhinted interop. Until a model matches that question, this host
       ;; predicts nothing; defnet's op=hostwarn reads Closure's own answer.
       :warns #{}}}
