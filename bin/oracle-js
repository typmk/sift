#!/usr/bin/env bb
;; The property names Closure's default externs declare, as a set: the JS
;; host's oracle. shadow-cljs's :infer-externs :auto warns on a member access
;; to an untyped target only when the property is not already known, and the
;; externs are what it knows without reading the build's npm sources.
;;
;;   bin/oracle-js [closure-compiler.jar] > externs.edn
;;
;; Without a jar argument, the newest closure-compiler jar in ~/.m2. Measured
;; on a ClojureScript app before its 42 :infer-warnings were fixed: P 0.84
;; R 1.00. The 8 false positives were npm library property names shadow knew
;; from sources this does not read; adding every property name in those npm
;; sources removed the 8 and lost 14 true positives, so that is not the rule.
(require '[babashka.fs :as fs] '[clojure.string :as str] '[clojure.java.io :as io])
(let [jar (or (first *command-line-args*)
              (->> (fs/glob (str (System/getProperty "user.home") "/.m2/repository/com/google/javascript/closure-compiler") "**/closure-compiler-v*.jar")
                   (map str) (remove #(str/includes? % "sources")) sort last))
      _ (when-not jar (binding [*out* *err*] (println "no closure-compiler jar found")) (System/exit 2))
      tmp (fs/create-temp-dir)
      zip (java.util.zip.ZipFile. (str jar))
      entry (.getEntry zip "externs.zip")
      inner (str tmp "/externs.zip")]
  (with-open [in (.getInputStream zip entry) out (io/output-stream inner)] (io/copy in out))
  (let [z (java.util.zip.ZipFile. inner)
        names (into (sorted-set)
                    (for [e (enumeration-seq (.entries z)) :when (str/ends-with? (.getName e) ".js")
                          [_ p] (re-seq #"\.([A-Za-z_$][A-Za-z0-9_$]*)" (slurp (.getInputStream z e)))]
                      p))]
    (binding [*out* *err*] (println (count names) "property names from" (fs/file-name jar)))
    (prn names)))
