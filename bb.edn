{:paths ["script"]
 :deps  {net.typemark/sift {:local/root "."}}
 :bbin/bin {sift {:main-opts ["-m" "net.typemark.sift.cli"]}}
 :tasks
 {:requires ([babashka.fs :as fs] [clojure.string :as str])

  test
  {:doc  "The gate: the unit suite on the JVM."
   :task (clojure "-M:test")}

  parity
  {:doc  "Every test-corpus file through sift/analyze on the JVM and on node; the two must be identical."
   :task (do (fs/create-dirs "target")
             (clojure {:out "target/jvm.edn"} "-M:parity")
             (clojure "-M:cljs")
             (shell {:out "target/node.edn"} "node target/parity.js")
             (let [jvm (slurp "target/jvm.edn") node (slurp "target/node.edn")]
               (when (or (empty? jvm) (not= jvm node))
                 (println "JVM and node disagree: diff target/jvm.edn target/node.edn")
                 (System/exit 1))
               (println (count (str/split-lines jvm)) "rows, identical on the JVM and node")))}

  validate
  {:doc      "The measurement: typeflow against every corpus oracle in corpora/, and the evidence ledger. [--residue] [corpus …]"
   :requires ([validate])
   :task     (apply validate/-main *command-line-args*)}}}
