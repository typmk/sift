;; What each rule's verdict rests on — the honest bar, as data, carried on
;; every finding as :evidence so a consumer sees it without reading the
;; README. A rule absent from here fails the suite (evidence_test).
;;
;;   :compiler  judged against the host compiler's own warnings (assay notes,
;;              Closure log) on named corpora; numbers in the README
;;   :parity    judged against an independent implementation on a shared
;;              corpus (cccc, SonarJS)
;;   :corpus    a flag/clear corpus pair per rule, and every hit on real code
;;              read before landing
;;   :read      no oracle exists; every hit on the named corpora was read at
;;              its line on the date given, wrong ones fixed at the cause
;;   :unjudged  a rule whose hits have not been read on real code — a claim
;;
;; The rung is the ceiling of what a finding under it can mean. :read and
;; :unjudged rules are REVIEW lists whatever their :category says.
{:families {:typeflow :compiler :complexity :parity :shape :corpus :prose :corpus :node :read}
 :rules
 {;; typeflow — bin/falsify, four corpora, 2026-08-27
  :typeflow/boxed-math   {:evidence :compiler :note "six corpora, 3,351 notes, all matched after reading; blind first scores: clojure-mcp 79/79, darling 38/39, kora P 0.82 R 0.99 — README table"}
  :typeflow/reflection   {:evidence :compiler :note "six corpora, 285 notes, all matched after reading; blind first scores: clojure-mcp P 0.92 R 0.75, darling P 0.85 R 0.85, kora P 0.71 R 0.88 — README table"}
  :typeflow/uninferred   {:evidence :compiler :note "648 predicted vs 0 Closure warnings on defnet: the JS model is wrong and predicts nothing"}
  :js-prop-on-own-object {:evidence :corpus :note "found render.cljs:367 shipped; corpus flag/clear"}
  :reflection-unwarned   {:evidence :corpus}
  ;; complexity
  :cognitive-complexity  {:evidence :parity :note "5,519/5,531 units vs cccc on defnet; Spearman 0.989 vs SonarJS on LightTable"}
  ;; shape and data rules — corpus/{flag,clear}
  :place-as-fold {:evidence :corpus :note "17/17 with the standalone CLI on defnet"}
  :loop-as-map {:evidence :corpus} :loop-as-reduce {:evidence :corpus :note "0 on hand-written code, 1 in clojure.core — fires on generated code"}
  :cond-as-case {:evidence :corpus :note "1 on defnet, 7 in clojure.core, all read"}
  :catch-all-swallow {:evidence :corpus :note "65 on defnet, this repo's every-failure-is-a-value style; baseline them"}
  :mutable-escape {:evidence :corpus}
  :first-filter-is-some {:evidence :corpus :note "ten hits on defnet read; the first counterpart was wrong and retracted"}
  :cond-literals-with-else-is-case {:evidence :corpus}
  :deref-inside-own-swap {:evidence :corpus :note "one on lume secrets.clj:285, a real lost update"}
  :thread-sleep {:evidence :corpus}
  ;; prose — corpus/prose, and every hit on defnet read
  :doc/restates-name {:evidence :corpus :note "7 on defnet, all real"} :doc/hedge {:evidence :corpus}
  :doc/params-unnamed {:evidence :corpus :note "272 -> 133 on defnet after the length guard; the cut ones were read"}
  :doc/placeholder {:evidence :corpus} :doc/ns-missing {:evidence :corpus}
  ;; node rules — 68 hits on lume, sift, agentia read 2026-08-27
  :permissive-file-permissions {:evidence :read :note "4/4 wrong (HTTP status keys); fixed — a call argument under a mode-setting head"}
  :hardcoded-credential {:evidence :read :note "4/4 wrong (*-secret-type slugs); fixed — a name ending -type/-kind names a kind"}
  :unscoped-tenant-query {:evidence :read :note "43 on lume unjudgeable without the data model; 5/5 wrong on agentia, now vacuous where the corpus names no tenant"}
  :ambiguous-owner-check {:evidence :read :note "8 on lume, unjudged: needs the data model"}
  :csrf-protection-absent {:evidence :read :note "2 on lume, token-authenticated routes; the :delete-as-argument hits fixed"}
  :side-effect-in-swap {:evidence :read :note "1 on lume, the CAS-with-a-decision idiom; fixed"}
  :shell-invocation {:evidence :read :note "0 hits on the three corpora"}
  :xml-external-entity {:evidence :read :note "0 hits"}
  :operator-as-party {:evidence :read :note "0 hits; lume-specific by construction"}
  :discarded-future {:evidence :read :note "0 hits"}
  :redos-vulnerable-regex {:evidence :unjudged} :partial-match-validation {:evidence :unjudged}
  :cookie-missing-security-flags {:evidence :unjudged} :sensitive-data-logged {:evidence :unjudged}
  :xss-unescaped-output {:evidence :unjudged}
  :trust-all-certificates {:evidence :unjudged} :unsafe-deserialization {:evidence :unjudged}
  :jndi-injection {:evidence :unjudged} :predictable-temp-file {:evidence :unjudged}
  :disallow-doctype-decl {:evidence :unjudged} :external-general-entities {:evidence :unjudged}
  :external-parameter-entities {:evidence :unjudged} :load-external-dtd {:evidence :unjudged}
  :empty-test {:evidence :unjudged} :testing-without-assertion {:evidence :unjudged} :test-with-no-effect {:evidence :unjudged}
  :banned-term {:evidence :unjudged}
  :unparseable {:evidence :corpus :note "not a rule: the file did not read"}}}
