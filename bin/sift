#!/usr/bin/env bb
;; sift's CLI — the rules over source text, on files and directories, with no
;; graph and no index. defnet's `ingest op=scan` is the same code attached to
;; definitions; this is for a lint task or a human at a prompt.
;;
;;   sift lint <path>…         EVERY finding sift has for a file — one call,
;;                             one shape (sift/analyze); --family shape|node|
;;                             complexity|prose to narrow
;;   sift shape <path>…        the shape rules only (was agentia's `places`)
;;   sift complexity <path>…   units over the cognitive threshold (default 15)
;;   sift docs-mirror <kondo-analysis.json> <outdir>
;;                             each source file rewritten as ONLY its docstrings
;;                             at their original lines, as <path>.md — for Vale
;;                             (see vale/.vale.ini): vale's file:line is the
;;                             source's
;;   sift vale-sarif <vale.json>   Vale's --output=JSON as SARIF on stdout, for
;;                             defnet's `ingest op=sarif` — no new reader
;;   sift vale-style <dir>     write vale/styles/Sift/*.yml from prose.cljc's
;;                             token lists, so there is one list
;;   --edn                     print findings as EDN
;;   --threshold N             complexity only
;;   --analysis FILE           shape only: clj-kondo analysis JSON, so aliased
;;                             core vars resolve and shadowed ones do not
;;   --baseline FILE           report only findings NOT in FILE (detekt's ratchet)
;;   --write-baseline FILE     write the current findings as the baseline and exit 0
;;
;; Exit 1 when anything is reported, 0 when clean, 2 on usage. Reports; the
;; gate is the caller's — sift never writes.
(require '[babashka.classpath :as cp] '[babashka.fs :as fs] '[clojure.string :as str])
(cp/add-classpath (str (fs/parent (fs/parent (fs/real-path *file*))) "/src"))
(require '[com.typemark.sift.prose :as prose]
         '[com.typemark.sift :as sift]
         '[cheshire.core :as json-out]
         '[com.typemark.sift.json :as sjson]
         '[com.typemark.sift.shape :as shape]
         '[com.typemark.sift.resolve :as resolve]
         '[com.typemark.sift.baseline :as baseline]
         '[com.typemark.sift.complexity :as cx])

(defn- clj-file? [p] (contains? #{"clj" "cljs" "cljc"} (fs/extension p)))

(defn- expand [path]
  (let [p (fs/path path)]
    (cond (fs/regular-file? p) (if (clj-file? p) [p] [])
          (fs/directory? p) (filterv clj-file? (fs/glob p "**.{clj,cljs,cljc}"))
          :else (throw (ex-info (str "not a file or directory: " path) {:path (str path)})))))

(defn- print-finding [{:keys [file line column rule message instruction counterpart applicability evidence]}]
  (printf "%s:%s:%s %s [%s] %s\n" file line (or column 1) (name rule) (name (or evidence :unjudged)) message)
  (when instruction (printf "  rewrite: %s\n" instruction))
  (when counterpart (printf "  counterpart (%s):\n    %s\n" (name applicability) (pr-str counterpart))))

(defn- docs-mirror!
  "kondo analysis JSON -> outdir/<file> holding only docstrings, each at the
  row kondo gave the var (the doc starts on the line after the name; one
  line off is inside the definition's span, which is all attribution needs)."
  [analysis-file outdir]
  (let [a (get (sjson/read-str (slurp analysis-file)) "analysis")
        by-file (group-by #(get % "filename")
                          (concat (get a "var-definitions") (get a "namespace-definitions")))]
    (doseq [[file defs] by-file
            :let [docs (->> defs
                            (keep (fn [d] (when (string? (get d "doc"))
                                            [(or (get d "name-row") (get d "row") 1) (get d "doc")])))
                            (sort-by first))]
            :when (seq docs)
            :let [out (fs/path outdir (str file ".md"))
                  lines (reduce (fn [acc [row doc]]
                                  (let [start (inc row)
                                        acc (into acc (repeat (max 0 (- start (count acc) 1)) ""))
                                        acc (conj acc (str "## " (or (some #(when (= row (or (get % "name-row") (get % "row"))) (get % "name")) defs) file)))]
                                    (into acc (str/split-lines doc))))
                                [] docs)]]
      (fs/create-dirs (fs/parent out))
      (spit (str out) (str (str/join "\n" lines) "\n")))
    (println (count by-file) "files mirrored to" outdir)))

(defn- vale->sarif
  "Vale --output=JSON -> SARIF 2.1.0. Rule ids are Vale's Check names
  (Sift.Hedge); levels map suggestion->note, warning->warning, error->error."
  [vale-json-file]
  (let [v (sjson/read-str (slurp vale-json-file))
        level (fn [s] (case s "error" "error" "warning" "warning" "note"))
        checks (distinct (for [[_ alerts] v a alerts] (get a "Check")))
        results (for [[file alerts] v a alerts]
                  {:ruleId (get a "Check")
                   :level (level (get a "Severity"))
                   :message {:text (get a "Message")}
                   ;; the mirror is <source>.md; the uri is the source, so
                   ;; defnet's suffix match lands on the graph's file
                   :locations [{:physicalLocation {:artifactLocation {:uri (str/replace file #"\.md$" "")}
                                                   :region {:startLine (get a "Line")}}}]})]
    {:version "2.1.0"
     :$schema "https://json.schemastore.org/sarif-2.1.0.json"
     :runs [{:tool {:driver {:name "vale"
                             :rules (for [c checks] {:id c :defaultConfiguration {:level "warning"}})}}
             :results (vec results)}]}))

(defn- usage []
  (binding [*out* *err*]
    (println "usage: sift (lint | shape | complexity) [--edn] [--family F] [--threshold N] [--analysis A] [--baseline B] <path> ...  |  sift docs-mirror <analysis.json> <outdir>  |  sift vale-sarif <vale.json>"))
  (System/exit 2))

(when (= "docs-mirror" (first *command-line-args*))
  (let [[_ analysis outdir] *command-line-args*]
    (when-not (and analysis outdir) (usage))
    (docs-mirror! analysis outdir)
    (System/exit 0)))
(when (= "vale-style" (first *command-line-args*))
  (let [[_ dir] *command-line-args*
        yml (fn [name extends level msg tokens]
              (str "# GENERATED by `bin/sift vale-style` from com.typemark.sift.prose — edit there.\n"
                   "extends: " extends "\nmessage: \"" msg "\"\nlevel: " level "\nignorecase: true\ntokens:\n"
                   (str/join "" (map #(str "  - " % "\n") tokens))))]
    (when-not dir (usage))
    (fs/create-dirs dir)
    (spit (str (fs/path dir "Hedge.yml")) (yml "Hedge" "existence" "warning" "Hedge in docstring: '%s'. A docstring is the contract." prose/hedges))
    (spit (str (fs/path dir "Placeholder.yml")) (yml "Placeholder" "existence" "error" "Docstring is a placeholder: '%s'." prose/placeholder-tokens))
    (println "wrote Hedge.yml and Placeholder.yml to" dir)
    (System/exit 0)))

(when (= "vale-sarif" (first *command-line-args*))
  (let [[_ vale-json] *command-line-args*]
    (when-not vale-json (usage))
    (println (json-out/generate-string (vale->sarif vale-json)))
    (System/exit 0)))

(let [args      *command-line-args*
      cmd       (first args)
      rest-args (rest args)
      edn?      (some #{"--edn"} rest-args)
      threshold (some->> rest-args (drop-while #(not= "--threshold" %)) second parse-long)
      analysis  (some->> rest-args (drop-while #(not= "--analysis" %)) second)
      resolution (when analysis (resolve/index (slurp analysis)))
      base-file (some->> rest-args (drop-while #(not= "--baseline" %)) second)
      write-base (some->> rest-args (drop-while #(not= "--write-baseline" %)) second)
      family    (some->> rest-args (drop-while #(not= "--family" %)) second keyword)
      paths     (->> rest-args
                     (remove #(str/starts-with? % "--"))
                     (remove #(and threshold (= % (str threshold))))
                     (remove #(and analysis (= % analysis)))
                     (remove #(and base-file (= % base-file)))
                     (remove #(and write-base (= % write-base)))
                     (remove #(and family (= % (name family))))
                     vec)
      ;; once over the corpus, not per file: a file with no tenancy word still
      ;; belongs to a tenanted project, and a project with none is not one
      tenanted  (delay (sift/tenanted? (map (comp slurp str (fn [p] (fs/absolutize p))) (mapcat expand paths))))
      run       (case cmd
                  "lint"       (fn [file]
                                 (let [{:keys [ok? error findings]} (sift/analyze {:text (slurp file) :path file :resolution resolution
                                                                                   :tenanted? @tenanted})]
                                   (if-not ok?
                                     [{:file file :line 1 :column 1 :rule :unparseable :message error}]
                                     (cond->> (map #(assoc % :file file) findings)
                                       family (filter #(= family (:family %)))))))
                  "shape"      (fn [file] (shape/findings (slurp file) file resolution))
                  "complexity" (fn [file] (map #(assoc % :file file)
                                               (cx/findings (slurp file) file (or threshold cx/default-threshold))))
                  (usage))]
  (when (empty? paths) (usage))
  (let [;; Relative to the cwd, so a baseline is the same file on every machine.
        rel (fn [f] (str (fs/relativize (fs/cwd) f)))
        fs (vec (mapcat (fn [p] (map #(assoc % :file (rel (:file %)))
                                     (run (str (fs/absolutize p)))))
                        (mapcat expand paths)))
        fs (if base-file
             (baseline/new-findings (baseline/parse (slurp base-file)) fs)
             fs)]
    (when write-base
      (spit write-base (baseline/render (baseline/counts fs)))
      (println (count fs) "findings written to" write-base)
      (System/exit 0))
    (if edn?
      (prn fs)
      (if (seq fs) (run! print-finding fs) (println "no findings")))
    (flush)
    (System/exit (if (seq fs) 1 0))))
